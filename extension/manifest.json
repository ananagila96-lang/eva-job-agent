{
  "manifest_version": 3,
  "name": "EVA-01 Job Assistant",
  "version": "1.1.0",
  "description": "Assistente local para varrer vagas e preparar candidaturas no LinkedIn sob comando da usuaria.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EVA-01"
  }
}
